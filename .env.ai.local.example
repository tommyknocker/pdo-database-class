# Copy to .env.ai.local and keep the local file private (chmod 600).
# This file is loaded only by scripts/test-ai-live.php, never by ordinary tests.
PDODB_AI_PROVIDER=openrouter
PDODB_AI_OPENROUTER_KEY=
# Choose an actual model ID available in your OpenRouter account.
PDODB_AI_OPENROUTER_MODEL=

# Three small requests per explicit live run. No automatic retries.
PDODB_AI_LIVE_MAX_TOKENS=256
PDODB_AI_LIVE_TIMEOUT=45
# Optional OpenRouter reasoning effort; use only values supported by your model.
# A small total output budget can be consumed entirely by reasoning.
PDODB_AI_LIVE_REASONING_EFFORT=

# For a different compatible gateway, use these instead:
# PDODB_AI_PROVIDER=openai-compatible
# PDODB_AI_OPENAI_COMPATIBLE_BASE_URL=https://gateway.example.com/v1
# PDODB_AI_OPENAI_COMPATIBLE_KEY=
# PDODB_AI_OPENAI_COMPATIBLE_MODEL=
